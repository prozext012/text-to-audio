# GEMINI_API_KEY: Wajib untuk panggilan API Gemini (termasuk gemini-3.8-flash-tts).
# Di AI Studio: Diinjeksi otomatis dari panel Secrets.
# Di Vercel: Tambahkan di Settings > Environment Variables dengan nama GEMINI_API_KEY.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: URL host aplikasi (opsional)
APP_URL="http://localhost:3000"
